@echo off
echo ============================================================
echo DocManager - Настройка брандмауэра Windows
echo ============================================================
echo.
echo Этот скрипт добавит правило в брандмауэр Windows для порта 8080
echo Требуется запуск от имени администратора!
echo.
pause

echo.
echo Добавление правила в брандмауэр...
netsh advfirewall firewall add rule name="DocManager Port 8080" dir=in action=allow protocol=TCP localport=8080

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ============================================================
    echo УСПЕШНО! Правило брандмауэра добавлено.
    echo Теперь сервер будет доступен из локальной сети на порту 8080
    echo ============================================================
) else (
    echo.
    echo ============================================================
    echo ОШИБКА! Не удалось добавить правило.
    echo Убедитесь что скрипт запущен от имени администратора:
    echo   Правый клик -> Запуск от имени администратора
    echo ============================================================
)

echo.
pause
